<launch>
    <node pkg="visual_servoing" exec="cone_detector" name="cone_detector" output="screen"> </node>
    <node pkg="path_planning" exec="trajectory_planner" name="trajectory_planner" output="screen">
        <param from="$(find-pkg-share path_planning)/config/real/config.yaml"/>
    </node>
    <node pkg="path_planning" exec="trajectory_follower" name="trajectory_follower">
        <param from="$(find-pkg-share path_planning)/config/real/config.yaml"/>
    </node>
    <node pkg="localization" exec="particle_filter" name="particle_filter" output="screen">
        <param from="$(find-pkg-share path_planning)/config/real/pf_config.yaml"/>
    </node>
    <node pkg="wall_follower" exec="wall_follower" name="wall_follower" output="screen">
        <param from="$(find-pkg-share wall_follower)/params.yaml"/>
    </node>
    <node pkg="safety_controller" exec="safety_controller" name="safety_controller" output="screen"> </node>
    <node pkg="dectection" exec="detection" name="detection" output="screen"> </node>
    <node pkg="dectection" exec="drive" name="drive" output="screen"> </node>
    <node pkg="dectection" exec="state" name="state" output="screen"> </node>

</launch>
